{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=bullion.db"
  },
  "Jwt": {
    "Issuer": "bullion-trading-api",
    "Audience": "bullion-trading-clients",
    "SigningKey": "",
    "LifetimeMinutes": 60
  },
  "RateFeed": {
    "Simulated": true,
    "IntervalMs": 1000,
    "OpeningPrices": { "Gold": 11500, "Silver": 140 },
    "Volatility": 0.0005
  },
  "Trading": {
    "QuoteTtlSeconds": 30
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  }
}
